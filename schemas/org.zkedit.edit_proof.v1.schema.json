{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fightfake.ai/schemas/org.zkedit.edit_proof.v1.schema.json",
  "title": "org.zkedit.edit_proof.v1",
  "type": "object",
  "required": [
    "assertion_type",
    "version",
    "proof_system",
    "circuit_variant",
    "gadget_id",
    "h1",
    "h2",
    "proof_sha256",
    "proof_size_bytes"
  ],
  "properties": {
    "assertion_type": {
      "const": "org.zkedit.edit_proof.v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "proof_system": {
      "type": "string",
      "enum": ["nova-groth16"]
    },
    "circuit_variant": {
      "type": "string",
      "enum": ["edit_only", "edit_encode"]
    },
    "gadget_id": {
      "type": "string",
      "minLength": 1
    },
    "h1": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$"
    },
    "h2": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$"
    },
    "proof_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "proof_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "gadget_params": {
      "description": "Gadget-specific parameters (e.g. brightness scale, or redact region + frame range). Omitted when the gadget takes no parameters.",
      "type": "object"
    },
    "touched_window": {
      "description": "Present when the ZK proof only covers a scoped 'touched' frame range (e.g. --touched-window with redact); pre/post segments outside this range are attested by plain hashes instead of the circuit. h1/h2 above are then SHA256(\"pre\" || pre || \"mid\" || mid || \"post\" || post) over the matching segment hashes.",
      "type": "object",
      "required": ["frame_start", "frame_end", "num_frames", "h1_segments", "h2_segments"],
      "properties": {
        "frame_start": { "type": "integer", "minimum": 0 },
        "frame_end": { "type": "integer", "minimum": 0 },
        "num_frames": { "type": "integer", "minimum": 0 },
        "h1_segments": { "$ref": "#/$defs/segmentHashes" },
        "h2_segments": { "$ref": "#/$defs/segmentHashes" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "segmentHashes": {
      "type": "object",
      "required": ["pre", "mid", "post"],
      "properties": {
        "pre": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "mid": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "post": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    }
  }
}
